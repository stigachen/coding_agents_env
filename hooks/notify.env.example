# 复制到 ~/.claude/notify.env 并填写（install.sh 会自动生成模板）。
# 该文件是每台机器的本地密钥配置，不要提交进仓库。
# 留空的渠道会被跳过；一个都不填则 hook 静默退出。

# Telegram：找 @BotFather 建 bot 拿 token；chat_id 可通过给 bot 发消息后
# 访问 https://api.telegram.org/bot<TOKEN>/getUpdates 查到
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord：服务器设置 → 整合 → Webhook → 复制 URL
DISCORD_WEBHOOK_URL=

# ---- 通知类型开关（0=关 1=开；改完即时生效，无需重装或重启会话）----

# 待审批：权限提示弹出约 6 秒无人处理时提醒
NOTIFY_ON_PERMISSION=1

# 等输入：回合结束后约 60 秒无人输入时提醒
NOTIFY_ON_IDLE=1

# 回合结束（Stop 事件）：每个回合都触发，短对话时可能偏吵；设 0 关闭，
# 只保留"待审批 / 等输入"两类通知
NOTIFY_ON_STOP=1

# macOS 本机桌面弹窗（人在电脑前但窗口在后台时用），设 1 开启
DESKTOP_NOTIFY=0

# 消息前缀带主机名（[项目@主机]）：多台机器共用同一个 Telegram/Discord 渠道时
# 用来区分来源。设 0 只显示项目名
NOTIFY_SHOW_HOST=1

# 来自 Grok CLI 的事件：xAI Grok CLI 默认会执行 ~/.claude/settings.json 里的
# hooks（compat.claude.hooks），Grok 的每个回合也会触发本脚本。默认 0 忽略；
# 设 1 则照常推送，消息里标成 "Grok"
NOTIFY_FROM_GROK=0

# 排障日志：设 1 后每次事件的判定过程（调用方、前台静音判断、推送结果与
# curl 响应）写入 ~/.claude/notify-debug.log；查完记得改回 0
NOTIFY_DEBUG=0

# 前台静音：Claude Code 所在终端窗口有键盘焦点时跳过所有推送（macOS 和
# Windows Git Bash 均支持；判定的是焦点而非可见，多显示器下窗口可见但
# 焦点在别处仍会推送）。设 0 关闭，恢复无条件推送
NOTIFY_SKIP_WHEN_FOCUSED=1

# 前台静音的"人已走开"兜底：窗口虽聚焦但全局无键鼠输入超过该秒数则照常
# 推送；锁屏另有显式检测（锁屏中一律照常推送），不受此阈值影响
NOTIFY_FOCUS_MAX_IDLE=120

# ---- 状态栏（statusline.sh 读取，同样改完即时生效）----

# 订阅用量的接口路径：设 1 后状态栏额外显示按模型的周配额（如 fable_weekly:7%），
# 方式是用本机 Claude Code 的 OAuth token 调 Anthropic 未公开的用量接口
# （每 5 分钟至多一次，只读、不耗额度）。默认 0 关闭：只显示 Claude Code 自己喂给
# 状态栏的 session/weekly，不读凭据、不发任何请求。老版本 Claude Code 不提供
# stdin 用量数据，需要设 1 才有用量显示
STATUSLINE_USAGE_API=0
