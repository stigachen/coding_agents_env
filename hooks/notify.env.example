# 复制到 ~/.claude/notify.env 并填写（install.sh 会自动生成模板）。
# 该文件是每台机器的本地密钥配置，不要提交进仓库。
# 留空的渠道会被跳过；一个都不填则 hook 静默退出。

# Telegram：找 @BotFather 建 bot 拿 token；chat_id 可通过给 bot 发消息后
# 访问 https://api.telegram.org/bot<TOKEN>/getUpdates 查到
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord：服务器设置 → 整合 → Webhook → 复制 URL
DISCORD_WEBHOOK_URL=

# 每个回合结束（Stop 事件）是否也通知；短对话时可能偏吵，设 0 关闭，
# 只保留"需要审批 / 等待输入"两类通知
NOTIFY_ON_STOP=1

# macOS 本机桌面弹窗（人在电脑前但窗口在后台时用），设 1 开启
DESKTOP_NOTIFY=0
