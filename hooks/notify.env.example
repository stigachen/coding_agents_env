# 复制到 ~/.claude/notify.env 并填写（install.sh 会自动生成模板）。
# 该文件是每台机器的本地密钥配置，不要提交进仓库。
# 留空的渠道会被跳过；一个都不填则 hook 静默退出。

# Telegram：找 @BotFather 建 bot 拿 token；chat_id 可通过给 bot 发消息后
# 访问 https://api.telegram.org/bot<TOKEN>/getUpdates 查到
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord：服务器设置 → 整合 → Webhook → 复制 URL
DISCORD_WEBHOOK_URL=

# ---- 通知类型开关（0=关 1=开；改完即时生效，无需重装或重启会话）----

# 待审批：权限提示弹出约 6 秒无人处理时提醒
NOTIFY_ON_PERMISSION=1

# 等输入：回合结束后约 60 秒无人输入时提醒
NOTIFY_ON_IDLE=1

# 回合结束（Stop 事件）：每个回合都触发，短对话时可能偏吵；设 0 关闭，
# 只保留"待审批 / 等输入"两类通知
NOTIFY_ON_STOP=1

# macOS 本机桌面弹窗（人在电脑前但窗口在后台时用），设 1 开启
DESKTOP_NOTIFY=0

# 前台静音：Claude Code 所在终端窗口有键盘焦点时跳过所有推送（macOS 和
# Windows Git Bash 均支持；判定的是焦点而非可见，多显示器下窗口可见但
# 焦点在别处仍会推送）。设 0 关闭，恢复无条件推送
NOTIFY_SKIP_WHEN_FOCUSED=1

# 前台静音的"人已走开"兜底：窗口虽聚焦但全局无键鼠输入超过该秒数则照常
# 推送；锁屏另有显式检测（锁屏中一律照常推送），不受此阈值影响
NOTIFY_FOCUS_MAX_IDLE=120
